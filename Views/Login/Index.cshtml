@model LoginViewModel

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger text-center">
        <p>@ViewBag.ErrorMessage</p>
    </div>
}

<!-- Mostrar mensaje de error si existe -->
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger text-center" role="alert">
        @Model.ErrorMessage
    </div>
}

@if (Model.IsAuthenticated)
{
    <a class="nav-link" href="@Url.Action("Logout", "Login")">Cerrar Sesión</a>
}
else
{
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; background-color: #f3f4f6;">
        <div class="card shadow-lg p-5 rounded-4" style="max-width: 380px; width: 100%; background-color: #ffffff; border-radius: 20px;">
            <h4 class="card-title text-center mb-4" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #4b4b4b;">Iniciar sesión</h4>
            <form method="post" asp-action="Login">
                <div class="mb-3">
                    <label for="username" class="form-label" style="font-size: 1.1rem; color: #6c757d;">Usuario:</label>
                    <input type="text" class="form-control form-control-lg" id="username" name="username" value="@Model.Username" required style="border-radius: 15px;"/>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label" style="font-size: 1.1rem; color: #6c757d;">Contraseña:</label>
                    <input type="password" class="form-control form-control-lg" id="password" name="password" required style="border-radius: 15px;"/>
                </div>

                <div class="d-grid gap-2 mb-4">
                    <button type="submit" class="btn btn-primary btn-lg" style="background-color: #ab1ff1; border-color: #166c8c; border-radius: 25px;">Iniciar sesión</button>
                </div>
            </form>

            <div class="d-grid gap-2">
                <a asp-controller="Login" asp-action="CrearUsuario" class="btn btn-success btn-lg" style="background-color: #28a745; border-radius: 25px;">Crear Usuario</a>
            </div>
        </div>
    </div>
}
