@model List<Producto>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger text-center mb-4">
        <p>@ViewBag.ErrorMessage</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center mb-4" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<h2 class="text-center text-primary mb-4">Lista de Productos</h2>

<table class="table table-striped table-hover table-bordered shadow-sm rounded">
    <thead class="table-light">
        <tr>
            <th>Descripción</th>
            <th>Precio</th>
            @if ((bool)ViewData["EsAdmin"])
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Descripcion</td>
                <td>$ @producto.Precio.ToString("0.00")</td>
                @if ((bool)ViewData["EsAdmin"])
                {
                    <td>
                        <a asp-controller="Producto" asp-action="ModificarProducto" asp-route-id="@producto.IdProducto" class="btn btn-warning btn-sm rounded-pill me-2">Editar</a>
                        <a asp-controller="Producto" asp-action="EliminarProducto" asp-route-id="@producto.IdProducto" class="btn btn-danger btn-sm rounded-pill">Eliminar</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-4">
    @if ((bool)ViewData["EsAdmin"])
    {
        <a asp-controller="Producto" asp-action="AltaProducto" class="btn btn-success btn-lg rounded-pill px-4 py-2">Alta Producto</a>
    }
</div>
