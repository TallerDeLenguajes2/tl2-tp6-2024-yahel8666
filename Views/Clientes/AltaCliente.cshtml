@model AltaClienteViewModel

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <strong>Error!</strong> @ViewBag.ErrorMessage
    </div>
}

<h2 class="mb-4">Crear Nuevo Cliente</h2>

<form asp-controller="Clientes" asp-action="CrearCliente" method="post">
    <div class="form-group">
        <label asp-for="Nombre" class="form-label">Nombre del Cliente</label>
        <input asp-for="Nombre" class="form-control" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Telefono" class="form-label">Teléfono</label>
        <input asp-for="Telefono" class="form-control" type="tel" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">Crear Cliente</button>
        <a asp-action="Index" class="btn btn-secondary ml-2">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
