@model List<Cliente>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger text-center mb-4">
        <p>@ViewBag.ErrorMessage</p>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center mb-4" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<h2 class="text-center text-primary mb-4">Lista de Clientes</h2>

<table class="table table-striped table-hover table-bordered shadow-sm rounded">
    <thead class="table-light">
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Teléfono</th>
            @if ((bool)ViewData["EsAdmin"])
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Nombre</td>
                <td>@cliente.Email</td>
                <td>@cliente.Telefono</td>
                @if ((bool)ViewData["EsAdmin"])
                {
                    <td>
                        <a asp-controller="Clientes" asp-action="ModificarCliente" asp-route-id="@cliente.ClienteId" class="btn btn-warning btn-sm rounded-pill me-2">Editar</a>
                        <a asp-controller="Clientes" asp-action="EliminarCliente" asp-route-id="@cliente.ClienteId" class="btn btn-danger btn-sm rounded-pill">Eliminar</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="text-center mb-4">
    @if ((bool)ViewData["EsAdmin"])
    {
        <a asp-controller="Clientes" asp-action="AltaCliente" class="btn btn-success btn-lg rounded-pill px-4 py-2">Alta Cliente</a>
    }
</div>
