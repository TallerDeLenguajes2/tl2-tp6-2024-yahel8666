@model List<Presupuesto>

<div class="text-center">
    <a asp-controller="Presupuesto" asp-action="NuevoPresupuesto" class="btn btn-success mb-2"> Nuevo presupuesto </a>
</div>

@{
    ViewBag.Title = "Listado de Presupuestos";
}

<h2> @ViewBag.Title</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th> Cliente</th>
                <th> Fecha de creacion </th>
                <th> Acciones </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var presupuesto in Model)
            {
                <tr>
                    @* <td>@(presupuesto.NombreDestinatario)</td> *@
                    <td>@presupuesto.FechaCreacion</td>

                    <td> <a asp-controller="Presupuesto" asp-action="ModificarPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-warning"> Editar </a> 

                    <a asp-controller="Presupuesto" asp-action="AgregarProductoAPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-success">Agregar Producto</a>

                    <a asp-controller="Presupuesto" asp-action="EliminarProductoAPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-danger"> Eliminar Producto</a>

                    <a asp-controller="Presupuesto" asp-action="DetallesDelPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-info">Detalles</a>

                    <a asp-controller="Presupuesto" asp-action="EliminarPresupuesto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-danger">Eliminar</a>


                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning" role="alert">
        No hay presupuestos disponibles.
    </div>
}